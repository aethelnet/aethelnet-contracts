# Ethereum Sepolia Deployment Configuration
SEPOLIA_PRIVATE_KEY=your_private_key_here_without_0x
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Micro-bundler (scripts/micro_bundler.js)
BUNDLER_HOST=127.0.0.1
BUNDLER_PORT=3000
# Comma-separated browser origins allowed to call the bundler (empty = none)
BUNDLER_CORS_ORIGINS=
